{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Alcove",
  "version": "0.1.0",
  "identifier": "com.alcove.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:43147",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Alcove",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "maximized": false,
        "fullscreen": false,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true
      },
      {
        "label": "bar",
        "url": "index.html?bar=1",
        "title": "Alcove Bar",
        "width": 1200,
        "height": 52,
        "resizable": false,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
