{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Alcove",
  "version": "0.2.3",
  "identifier": "com.alcove.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:43147",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Alcove",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "maximized": false,
        "fullscreen": false,
        "decorations": false,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "backgroundColor": [25, 25, 25]
      },
      {
        "label": "bar",
        "url": "index.html?bar=1",
        "title": "Alcove Bar",
        "width": 1200,
        "height": 52,
        "resizable": false,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      },
      {
        "label": "search",
        "url": "index.html?search=1",
        "title": "Alcove Search",
        "width": 544,
        "height": 424,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "center": true,
        "backgroundColor": [0, 0, 0, 0]
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/izkac/alcove/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGOUE5OTlDQ0UzNDk5QjYKUldTMm1UVE9uSm1hcnpkMVVVMXhHdy8raXNsUG42RENLdWNBdlhMS3QrczZTakdqSm5MdTZDbW4K",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  }
}
