{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main",
    "bar",
    "search",
    "desk-*"
  ],
  "permissions": [
    "core:default",
    "allow-attach-to-desktop",
    "allow-detach-from-desktop",
    "allow-desktop-attached",
    "allow-list-desktop-icons",
    "allow-list-folder-icons",
    "allow-list-known-folders",
    "allow-shell-icon",
    "allow-thumbnail",
    "allow-pick-folder",
    "allow-open-desktop-item",
    "allow-recycle-bin",
    "allow-show-recycle-bin-menu",
    "allow-empty-recycle-bin",
    "allow-recycle-bin-properties",
    "allow-paste-into-folder",
    "allow-recycle-desktop-items",
    "allow-desktop-background",
    "allow-set-windows-taskbar-hidden",
    "allow-windows-taskbar-hidden",
    "allow-list-running-windows",
    "allow-activate-window",
    "allow-focus-desktop",
    "allow-show-search-window",
    "allow-hide-search-window",
    "allow-autostart-enabled",
    "allow-set-autostart",
    "allow-this-desk",
    "allow-list-desks",
    "allow-desk-hit",
    "allow-load-desktop-state",
    "allow-save-desktop-state",
    "allow-update-available",
    "allow-install-update",
    "allow-licence-status",
    "allow-activate-licence"
  ]
}
